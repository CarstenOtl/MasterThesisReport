% Pipeline overview: decompose during data generation, unify at deployment.
\resizebox{\textwidth}{!}{%
\begin{tikzpicture}[
  font=\small,
  box/.style={draw, rounded corners=2pt, align=center, minimum height=9mm, inner sep=4pt, fill=white},
  rl/.style={box, fill=TUMBlue!12},
  sc/.style={box, fill=TUMOrange!15},
  st/.style={box, fill=TUMGreen!15},
  hu/.style={box, fill=red!10},
  stage/.style={draw, dashed, rounded corners=4pt, inner sep=6pt},
  arr/.style={-{Latex[length=2mm]}, thick},
  node distance=5mm and 7mm,
]
% --- Stage 1: hybrid teacher in simulation
\node[rl] (approach) {approach};
\node[rl, right=of approach] (grasp) {grasp};
\node[rl, right=of grasp] (rotate) {rotate};
\node[rl, right=of rotate] (goal) {goal\\reaching};
\node[sc, right=of goal] (release) {release};
\node[sc, right=of release] (return) {return\\\& reset};
\draw[arr] (approach) -- (grasp);
\draw[arr] (grasp) -- (rotate);
\draw[arr] (rotate) -- (goal);
\draw[arr] (goal) -- (release);
\draw[arr] (release) -- (return);
\draw[arr] (return.south) -- ++(0,-5mm) -| node[pos=0.25, below] {next cycle, $K=10$} (approach.south);
\begin{scope}[on background layer]
  \node[stage, fit=(approach) (goal), label={[anchor=south]above:{privileged RL teacher $\piT$ ($\MRL$)}}] (rlbox) {};
  \node[stage, fit=(release) (return), label={[anchor=south]above:{scripted $\kappa$ ($\Mscript$)}}] (scbox) {};
\end{scope}
\node[above=12mm of rotate.north, anchor=south, font=\small\bfseries] (title1) {hybrid teacher $\piHT$ in simulation, disturbed by random arm impulses};
% --- Stage 2: datasets
\node[st, below=18mm of grasp.south, anchor=north, text width=46mm] (dsim) {simulated demonstrations $\Dsim$\\(20 episodes, 10 cycles each)};
\node[hu, right=16mm of dsim, text width=50mm] (dreal) {real-world replay with sparse human corrections $\piH$: $\Dreal$};
\draw[arr] (rlbox.south) ++(12mm,0) -- ++(0,-7mm) -| (dsim.north);
\draw[arr] (dsim) -- node[above] {replay} (dreal);
% --- Stage 3: student
\node[st, below=9mm of dsim.south, anchor=north, xshift=33mm, text width=118mm, minimum height=12mm]
  (student) {conditional flow-matching student $\vfield(\Uc^{\lambda},\lambda\mid\cond_t)$:\\aligned RGB-D $\rightarrow$ point cloud $\rightarrow$ 64-D feature; proprioception; progress; phase $\rightarrow$ eight-step action chunk};
\draw[arr] (dsim.south) -- (dsim.south |- student.north);
\draw[arr] (dreal.south) -- (dreal.south |- student.north);
\node[below=3mm of student, font=\small\bfseries, text width=118mm, align=center] {deployment: one policy, no privileged state, no scripted controllers, no human assistance};
\end{tikzpicture}%
}
