% Hybrid-teacher data-collection loop (cyclic coordinator).
\begin{tikzpicture}[
  font=\small,
  x=1mm, y=1mm,
  state/.style={draw, rounded corners=3pt, align=center, minimum height=12mm, inner sep=3pt, fill=white, text width=44mm},
  rl/.style={state, fill=TUMBlue!12},
  sc/.style={state, fill=TUMOrange!15},
  gate/.style={draw, diamond, aspect=2, align=center, inner sep=0.5pt, fill=white},
  arr/.style={-{Latex[length=2mm]}, thick},
]
\node[rl] (policy) at (0,0) {threading policy $\bar{\pi}_{\mathrm{T}}$:\\approach, grasp, turn, hold};
\node[gate] (relgate) at (54,0) {turn\\reached?};
\node[sc] (waypoints) at (108,0) {release:\\four waypoints, 0.7\,s each};

\node[state, fill=TUMGreen!15] (rebase) at (0,-27) {rebase turn target,\\next cycle $k{+}1$};
\node[gate] (retgate) at (54,-27) {back at\\reset?};
\node[sc] (return) at (108,-27) {return to reset pose,\\1.0\,s};

\node[state] (done) at (0,-52) {episode complete};
\node[state, fill=red!10] (fail) at (54,-52) {transition failure:\\episode rejected};

\draw[arr] (policy) -- (relgate);
\draw[arr] (relgate) -- node[above] {yes} (waypoints);
\draw[arr] (relgate.north) -- ++(0,5) -| node[pos=0.25, above] {no} (policy.north);
\draw[arr] (waypoints) -- (return);
\draw[arr] (return) -- (retgate);
\draw[arr] (retgate) -- node[above] {yes} (rebase);
\draw[arr] (retgate) -- node[right] {timeout} (fail);
\draw[arr] (rebase) -- node[left] {$k<K$} (policy);
\draw[arr] (rebase) -- node[left] {$k=K$} (done);
\end{tikzpicture}%
