% Three-mode evaluation ladder.
\begin{tikzpicture}[
  font=\small,
  x=1mm, y=1mm,
  stage/.style={draw, rounded corners=3pt, align=center, text width=38mm, minimum height=12mm, inner sep=3pt},
  fail/.style={draw, rounded corners=3pt, align=center, text width=38mm, inner sep=2pt, fill=red!10, font=\footnotesize},
  arr/.style={-{Latex[length=2mm]}, thick},
]
\node[stage, fill=TUMGray3!60] (a) at (0,0)  {\textbf{1. Offline teacher-fit}\\recorded obs., no physics};
\node[stage, fill=TUMBlue!12]  (b) at (54,0) {\textbf{2. Teacher-forced clock}\\recorded obs., live physics};
\node[stage, fill=TUMGreen!15] (c) at (108,0) {\textbf{3. Closed loop}\\live obs., live physics};

\node[fail] (fa) at (0,-17)   {capacity, normalization, alignment};
\node[fail] (fb) at (54,-17)  {command contract, controller};
\node[fail] (fc) at (108,-17) {distribution shift, recovery};

\draw[arr] (a) -- node[above, font=\footnotesize] {pass} (b);
\draw[arr] (b) -- node[above, font=\footnotesize] {pass} (c);
\foreach \s/\f in {a/fa, b/fb, c/fc}
  \draw[arr, dashed] (\s) -- node[right, font=\footnotesize] {fail} (\f);
\end{tikzpicture}%
